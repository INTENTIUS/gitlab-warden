{
  "schema": 1,
  "kinds": [
    {
      "name": "forge-governance",
      "description": "a directory holding a gitlab-warden governance policy (governance.yml, or the older governance.yaml), which keeps GitLab groups and projects in declared state",
      "precedence": 200,
      "probe": { "anyFile": ["governance.yml", "governance.yaml"] },
      "outputs": ["repos", "teams"],
      "memberFile": { "path": "governance.yml", "schema": "schemas/governance.schema.json" },
      "graph": { "reader": "dist/graph-reader.mjs", "config": { "dir": "{dir}", "file": "governance.yml" } },
      "drift": { "reader": "dist/drift-reader.mjs", "config": { "dir": "{dir}", "file": "governance.yml", "tokenEnv": "GITLAB_TOKEN", "baseUrlEnv": "GITLAB_BASE_URL" } }
    }
  ]
}
